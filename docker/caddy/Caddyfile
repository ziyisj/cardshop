# ============================================================================
# Caddy 反向代理 + 自动 HTTPS
#
# {$DOMAIN} 和 {$ACME_EMAIL} 由 docker-compose 通过环境变量注入。
# Caddy 会自动向 Let's Encrypt 申请证书并自动续期。
#
# 前提：DOMAIN 已解析到本服务器公网 IP，且 80/443 端口对外放行。
# ============================================================================

{
	# ACME 账户邮箱（用于证书到期提醒）
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	# 反向代理到内部 nginx 容器（compose 服务名 web，监听 80）
	# Caddy 默认会带上 X-Forwarded-For / X-Forwarded-Proto / X-Forwarded-Host
	reverse_proxy web:80

	encode gzip zstd

	log {
		output stdout
		format console
	}
}
