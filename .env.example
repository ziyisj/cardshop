APP_NAME=CardShop
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cardshop
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# ==== License API signing ====
# 客户端与服务器共享的 HMAC 密钥（请务必改成随机长字符串）
LICENSE_HMAC_SECRET=change_this_to_a_long_random_secret_key_2026
# 服务器签发响应用的密钥（也可与上面相同）
LICENSE_SIGN_SECRET=change_this_to_another_long_random_secret_2026
# 允许的请求时间偏差（秒），防重放
LICENSE_TIMESTAMP_TOLERANCE=300

# ==== 管理后台默认账号（seeder 使用）====
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123456
